# App
APP_NAME="Usage Metering & Billing Engine"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Rate limiter
RATE_LIMIT_REQUESTS=100000
RATE_LIMIT_WINDOW_SECONDS=60

# Front-end URLs for checkout/portal redirects
FRONTEND_URL=http://localhost:3000

# Database (Docker default)
DATABASE_URL=postgresql+asyncpg://app_user:dev_password@localhost:5432/metering_billing

# Security
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Stripe TEST MODE ONLY (get from Stripe Dashboard → Developers → API keys)
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_FREE=price_xxx
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SUCCESS_URL=http://localhost:3000/success
STRIPE_CANCEL_URL=http://localhost:3000/cancel

# Pricing (micro-units, integer-only) - per 1,000 units
PRICE_API_CALL_PER_THOUSAND=1000000
PRICE_INPUT_TOKEN_PER_THOUSAND=150
PRICE_CACHED_INPUT_TOKEN_PER_THOUSAND=75
PRICE_OUTPUT_TOKEN_PER_THOUSAND=600
PRICE_REASONING_TOKEN_PER_THOUSAND=600